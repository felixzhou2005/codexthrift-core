# RouterLLM runtime home. Do not put OAuth tokens, API keys, or master keys in Git.
ROUTERLLM_HOME=$HOME/Library/Application Support/RouterLLM

# Existing LiteLLM proxy endpoint, used read-only until the supervised service migration is complete.
ROUTERLLM_PROXY_URL=http://127.0.0.1:4000
ROUTERLLM_DASHBOARD_HOST=127.0.0.1
ROUTERLLM_DASHBOARD_PORT=4876
